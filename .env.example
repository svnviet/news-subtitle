PORT=8100
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Must be reachable by the process -- a Windows Service (e.g. via NSSM) often
# runs with a much smaller PATH than an interactive shell and won't find a
# bare "ffmpeg"; set an absolute path in that case.
FFMPEG_BINARY=ffmpeg

# Required -- the app refuses to start without this. Every /v1/* route
# requires it on an X-API-Key header; /health is the only open route.
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUBTITLE_SERVICE_API_KEY=replace-with-a-real-random-secret
